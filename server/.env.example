# Server
PORT=5000
NODE_ENV=development

# Allow this origin to make API requests (your frontend URL)
CLIENT_URL=http://localhost:5173

# ----- Email (Nodemailer) -----
# For Gmail:
#   1. Enable 2-Step Verification on your Google account
#   2. Generate an App Password at https://myaccount.google.com/apppasswords
#   3. Use that 16-character password as EMAIL_PASS below
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password-here

# Where contact form submissions are delivered
EMAIL_TO=info@abeywardanagems.com

# WhatsApp number (used for logging / future integrations)
WHATSAPP_NUMBER=94740304669
